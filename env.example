# Required for Prisma generate, build, and runtime DB access.
DATABASE_URL=

# Optional but recommended for production migrations when your runtime URL is pooled.
# Vercel's production build can use this value for `prisma migrate deploy`.
DIRECT_DATABASE_URL=

# Clerk is required for authenticated routes and owner workflows.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Chrome extension session sync. These are read at `pnpm extension:build` time.
# The extension talks directly to Clerk, so the publishable key MUST match the
# Clerk instance the user actually signs into (pk_test_... locally, pk_live_...
# in production).
#
# SYNC_HOST and APP_URL are DIFFERENT domains in production and must not be
# collapsed into one value:
#   - SYNC_HOST is where Clerk syncs the browser session from. For a production
#     instance this is the Clerk Frontend API domain (decode your pk_live key,
#     e.g. https://clerk.your-domain.com), NOT the app domain. In dev it is
#     http://localhost.
#   - APP_URL is the House Vote web app origin used for /api/extension/* calls
#     and sign-in / open-trip links (https://your-domain.com in prod,
#     http://localhost:3000 in dev).
# Use https (not http) for deployed origins, or Clerk's Secure session cookie
# will not be visible to the extension.
HOUSE_VOTE_EXTENSION_SYNC_HOST=
HOUSE_VOTE_EXTENSION_APP_URL=
HOUSE_VOTE_EXTENSION_CLERK_PUBLISHABLE_KEY=
