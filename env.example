# Required for Prisma generate, build, and runtime DB access.
DATABASE_URL=

# Optional but recommended for production migrations when your runtime URL is pooled.
# Vercel's production build can use this value for `prisma migrate deploy`.
DIRECT_DATABASE_URL=

# Clerk is required for authenticated routes and owner workflows.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Chrome extension session sync. These are read at `pnpm extension:build` time.
# The extension talks directly to Clerk, so both values MUST point at the SAME
# Clerk instance / web origin the user actually signs into:
#   - Local web dev:  http://localhost:3000  + the pk_test_... key
#   - Production sync: https://your-domain.com + the pk_live_... key
# Use https (not http) for a deployed origin, or Clerk's Secure session cookie
# will not be visible to the extension.
HOUSE_VOTE_EXTENSION_SYNC_HOST=
HOUSE_VOTE_EXTENSION_CLERK_PUBLISHABLE_KEY=
